                           <pdfaType:prefix>seriesEditor</pdfaType:prefix>
                           <pdfaType:description>Specifies the types of series editor information: name and ORCID of a series editor.</pdfaType:description>
                           <pdfaType:field>
                              <rdf:Seq>
                                 <rdf:li rdf:parseType="Resource">
